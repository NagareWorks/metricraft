---
import api from "../../.generated/api.json";
import categories from "../data/api-categories.json";
import {
  href as localizedHref,
  localizedPage,
  pages,
} from "../data/navigation.mjs";
import { translator, type Locale } from "../data/translate";
interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const t = translator(locale);
const href = (slug = "") => localizedHref(slug, locale);
const localizedCategories = categories.map((category) => ({
  ...category,
  ...localizedPage(
    pages.find((page) => page.slug === `reference/api/${category.id}`),
    locale,
  ),
}));
---

<section id="signature-index">
  <h2>{t("Choose an API category")}</h2>
  <div class="api-category-grid">
    {
      localizedCategories.map((category) => (
        <a href={href(`reference/api/${category.id}`)}>
          <>
            <strong>
              {category.title} <span>↗</span>
            </strong>
            <p>{category.description}</p>
            <small>
              {
                api
                  .flatMap((cls) => cls.methods)
                  .filter((m) => m.category === category.id).length
              }{" "}
              {t("methods")}
            </small>
          </>
        </a>
      ))
    }
  </div>
  <details class="api-directory">
    <summary>{t("Find a method across all categories")}</summary>
    <div class="api-filter">
      <label for="api-filter">{t("Method name")}</label><input
        type="search"
        id="api-filter"
        placeholder={t("For example: count_gt_over_time")}
      /><p id="api-status" role="status"></p>
    </div>
    {
      api.map((cls) => (
        <section data-api-class>
          <>
            <h3 id={`api-${cls.name.toLowerCase()}`}>{cls.name}</h3>
            <ul class="api-directory-links">
              {cls.methods.map((method) => (
                <li
                  data-api-entry
                  data-filter={`${cls.name} ${method.name} ${method.category}`.toLowerCase()}
                >
                  <a
                    id={method.id}
                    data-api-redirect
                    href={`${href(`reference/api/${method.category}`)}#${method.id}`}
                  >
                    <code>{method.name}</code>
                    <span>
                      {
                        localizedCategories.find(
                          (category) => category.id === method.category,
                        )?.title
                      }
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        </section>
      ))
    }
  </details>
</section>
