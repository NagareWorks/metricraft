---
import api from "../../.generated/api.json";
import chineseApi from "../../.generated/api.zh.json";
import { repository } from "../data/navigation.mjs";
import { translator, type Locale } from "../data/translate";
interface Props {
  category: string;
  locale?: Locale;
}
const { category, locale = "en" } = Astro.props;
const t = translator(locale);
const classes = (locale === "zh" ? chineseApi : api)
  .map((cls) => ({
    ...cls,
    methods: cls.methods.filter((method) => method.category === category),
  }))
  .filter((cls) => cls.methods.length);
const signature = (
  cls: string,
  method: { name: string; signature: string; badges: string[] },
) => {
  if (method.badges.includes("property")) return `${cls}.${method.name}`;
  return `${cls}.${method.signature}`
    .replace(`${cls}.__init__`, cls)
    .replace(`${cls}.${cls}`, cls);
};
---

<section id="api-methods" class="api-reference">
  <h2>{t("Methods and parameters")}</h2>
  <div class="api-filter">
    <label for="api-filter">{t("Find on this page")}</label><input
      id="api-filter"
      type="search"
      placeholder={t("Method or parameter name…")}
    /><p id="api-status" role="status"></p>
  </div>
  {
    classes.map((cls) => (
      <section data-api-class id={`api-${cls.name.toLowerCase()}`}>
        <h3>{cls.name}</h3>
        {cls.methods.map((method) => (
          <details
            class="api-method"
            id={method.id}
            data-api-entry
            data-filter={`${cls.name} ${method.name} ${method.purpose} ${method.parameters.map((p) => p.name).join(" ")} ${method.badges.join(" ")}`.toLowerCase()}
          >
            <summary>
              <span>
                <code>
                  {method.name === "__init__" ? cls.name : method.name}
                  {method.badges.some((badge: string) => badge === "property")
                    ? ""
                    : "()"}
                </code>
                <span class="api-summary-purpose">{method.purpose}</span>
              </span>
              <span class="api-group">
                {method.badges.some((badge) => badge === "vm_only")
                  ? t("MetricsQL only")
                  : method.badges.some((badge) => badge === "prom_only")
                    ? t("PromQL only")
                    : ""}
              </span>
            </summary>
            <div class="api-detail">
              <div class="api-badges">
                {method.badges.map((badge) => (
                  <span>{t(badge.replaceAll("_", " "))}</span>
                ))}
              </div>
              <pre
                class="api-signature"
                data-copy-plain
                set:text={signature(cls.name, method)}
              />
              {method.notes && <p class="api-note">{method.notes}</p>}
              {method.parameters.length ? (
                <div class="api-parameters">
                  <table>
                    <caption>{t("Parameters")}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{t("Parameter / type")}</th>
                        <th scope="col">{t("Meaning and accepted values")}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {method.parameters.map((p) => (
                        <tr>
                          <th scope="row">
                            <code>{p.display}</code>
                            <span class="api-type">{p.type}</span>
                            <span class="api-default">
                              {p.default !== null
                                ? `${t("Default:")} ${p.default}`
                                : p.display.startsWith("*")
                                  ? t("Variadic")
                                  : t("Required")}
                            </span>
                          </th>
                          <td>{p.description}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <p class="api-no-params">{t("No parameters.")}</p>
              )}
              <p class="api-return">
                <strong>{t("Returns")}</strong> {method.returns}
              </p>
              {method.example && (
                <div class="api-example">
                  <h4>{t("Example")}</h4>
                  <pre
                    data-copy-plain
                    set:text={`from metricraft import QueryBuilder as Q\n\n${method.example}`}
                  />
                </div>
              )}
              <div class="api-links">
                <a
                  href={`${repository}/blob/main/${method.source}#L${method.line}`}
                >
                  {t("View declaration ↗")}
                </a>
                <a href={`#${method.id}`}>{t("Link to this method")}</a>
              </div>
            </div>
          </details>
        ))}
      </section>
    ))
  }
</section>
