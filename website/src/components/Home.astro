---
import { Code } from "astro:components";
import Shell from "../layouts/Shell.astro";
import { href as localizedHref, repository } from "../data/navigation.mjs";
import { translator, type Locale } from "../data/translate";
interface Props {
  locale: Locale;
  legacy?: boolean;
}
const { locale, legacy = false } = Astro.props;
const t = translator(locale);
const href = (slug = "") => localizedHref(slug, locale);
const example = `from metricraft import QueryBuilder as Q

requests = (
    Q.from_metric("http_requests_total")
    .where_eq("job", "api")
)

query = requests.rate("5m").sum().by("job")
text = query.build("promql")`;
const output = 'sum by (job) (rate(http_requests_total{job="api"}[5m]))';
---

<Shell
  home
  locale={locale}
  legacy={legacy}
  title={t("Queries, thoughtfully composed.")}
  description={t(
    "An immutable Python SDK for PromQL and MetricsQL. Build with a shared Rust core, save query strings anywhere, and execute them with one client.",
  )}
>
  <main id="content" data-pagefind-body>
    <section class="hero">
      <div class="hero-copy">
        <a class="release-note" href={href("internals/architecture")}
          ><span class="status-dot"></span>
          {t("A shared Rust core. A familiar Python API.")}
          <span aria-hidden="true">↗</span></a
        >
        <p class="eyebrow hero-eyebrow">{t("The MetriCraft field guide")}</p>
        <h1 data-pagefind-meta="title">
          {
            locale === "zh" ? (
              <>
                让查询，
                <>
                  <br />
                  <em>自然</em>
                  <br />
                </>
                成形。
              </>
            ) : (
              <>
                Queries, <br />
                <em>thoughtfully</em> <br />
                composed.
              </>
            )
          }
        </h1>
        <p class="hero-description">
          {
            t(
              "Build PromQL and MetricsQL with immutable expressions. Save the string. Query your backend. Keep the choices yours.",
            )
          }
        </p>
        <div class="hero-ctas">
          <a
            class="button primary"
            href={href("playground")}
            aria-describedby="playground-intro"
            >{t("Try the playground")} <span aria-hidden="true">↗</span></a
          ><a class="text-link" href={href("getting-started")}
            >{t("Getting started")} <span aria-hidden="true">→</span></a
          >
        </div>
        <p class="hero-playground-intro" id="playground-intro">
          {t("Choose filters. See the Python and PromQL. Try sample data.")}
        </p>
        <div class="hero-facts">
          <span>Python 3.8+</span><span>{t("Rust core")}</span><span
            >Apache 2.0</span
          >
        </div>
      </div>
      <div class="hero-example">
        <div class="code-window">
          <div class="code-title">
            <span><i></i><i></i><i></i></span><span>request_rate.py</span><span
              >PYTHON</span
            >
          </div><Code code={example} lang="python" theme="github-dark" /><div
            class="code-output"
          >
            <span class="eyebrow">{t("Generated PromQL")}</span><code
              >{output}</code
            >
          </div>
        </div>
        <div class="example-caption">
          <span class="branch-symbol" aria-hidden="true">⑂</span><p>
            {t("Derive a new expression.")}<br /><strong
              >{t("The original stays yours to reuse.")}</strong
            >
          </p><a href={href("concepts")}>{t("Why immutable? ↗")}</a>
        </div>
      </div>
    </section>
    <section class="workflow-section" aria-labelledby="workflow-title">
      <div class="section-heading">
        <span class="eyebrow">{t("A small SDK. A clear boundary.")}</span><h2
          id="workflow-title"
        >
          {t("From a user's choice")}<br />{t("to a useful answer.")}
        </h2><p>
          {t("Queries change with your application.")}<br />{
            t("Your infrastructure doesn't need to.")
          }
        </p>
      </div>
      <div class="workflow">
        <a class="workflow-step" href={href("examples/structured-selections")}
          ><span class="step-number">01 <span>↗</span></span><h3>
            {t("Build with structure.")}
          </h3><p>
            {
              t(
                "Turn filters, functions and grouping into expressions. Values are escaped; the chosen dialect is checked.",
              )
            }
          </p><code>query.build("promql")</code></a
        >
        <a class="workflow-step" href={href("examples/saved-queries")}
          ><span class="step-number">02 <span>↗</span></span><h3>
            {t("Store it your way.")}
          </h3><p>
            {
              t(
                "Keep ordinary query text in YAML, XML or your database. Persistence stays with your application.",
              )
            }
          </p><code>str → your storage → str</code></a
        >
        <a class="workflow-step" href={href("guides/client")}
          ><span class="step-number">03 <span>↗</span></span><h3>
            {t("Ask your backend.")}
          </h3><p>
            {
              t(
                "Send saved text to Prometheus or VictoriaMetrics with the same synchronous or asynchronous client.",
              )
            }
          </p><code>client.query(saved_text)</code></a
        >
      </div>
    </section>
    <section class="reading-section" aria-labelledby="reading-title">
      <div>
        <span class="eyebrow">{t("Go a little deeper")}</span><h2
          id="reading-title"
        >
          {t("Built to be")}<br />{t("understood.")}
        </h2><p>
          {t("Start with a working example.")}<br />{
            t("Follow the details as far as you need.")
          }
        </p>
      </div><div class="reading-list">
        <a href={href("guides/language-support")}
          ><span>01</span><div>
            <h3>{t("One builder. Two dialects.")}</h3><p>
              {
                t(
                  "Version baselines, supported forms and explicit feature flags.",
                )
              }
            </p>
          </div><span>↗</span></a
        >
        <a href={href("internals/memory")}
          ><span>02</span><div>
            <h3>{t("Shared trees, deliberate limits.")}</h3><p>
              {
                t(
                  "What immutability costs, what gets shared, and how to measure it.",
                )
              }
            </p>
          </div><span>↗</span></a
        >
        <a href={href("internals/backend-validation")}
          ><span>03</span><div>
            <h3>{t("Evidence behind the API.")}</h3><p>
              {t("Parser checks and expected results from real backends.")}
            </p>
          </div><span>↗</span></a
        >
      </div>
    </section>
    <section class="open-source-note">
      <div class="open-source-mark" aria-hidden="true">{`{ }`}</div><div>
        <span class="eyebrow">{t("Open source, in the open")}</span><h2>
          {t("A query is a good place to start.")}
        </h2><p>
          {
            t(
              "Native wheels are available on PyPI. Install MetriCraft, try an example, and help shape what comes next.",
            )
          }
        </p>
      </div><a class="button secondary" href={repository}
        >{t("Find us on GitHub ↗")}</a
      >
    </section>
  </main>
</Shell>
