---
import { groups, href } from "../data/navigation.mjs";
interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<nav aria-label="Documentation">
  {
    groups.map((group) => (
      <div class="nav-group">
        <p>{group.title}</p>
        <ul>
          {group.pages
            .filter((page) => !("parent" in page))
            .map((page) => (
              <li>
                {page.slug === "reference/api" ? (
                  <details
                    class="api-nav"
                    open={
                      current?.startsWith("reference/api") ||
                      current === "reference/models"
                    }
                  >
                    <summary>Python API</summary>
                    <ul>
                      <li>
                        <a
                          href={href(page.slug)}
                          aria-current={
                            current === page.slug ? "page" : undefined
                          }
                        >
                          Overview
                        </a>
                      </li>
                      {group.pages
                        .filter((p) => "parent" in p && p.parent === page.slug)
                        .map((p) => (
                          <li>
                            <a
                              href={href(p.slug)}
                              aria-current={
                                current === p.slug ? "page" : undefined
                              }
                            >
                              {p.title}
                            </a>
                          </li>
                        ))}
                    </ul>
                  </details>
                ) : (
                  <a
                    href={href(page.slug)}
                    aria-current={current === page.slug ? "page" : undefined}
                  >
                    {page.title}
                  </a>
                )}
              </li>
            ))}
        </ul>
      </div>
    ))
  }
</nav>
