---
import "../styles/playground.css";
---

<div class="playground" data-pagefind-ignore>
  <div class="lab-banner">
    <span class="status-dot"></span> Local workspace <span
      >Rust builder · browser sample data</span
    >
  </div>
  <div class="lab-grid">
    <form id="query-controls" class="lab-panel">
      <div class="lab-panel-heading">
        <span class="lab-number">01</span><h2>Configure a query</h2>
      </div>
      <label for="lab-metric">Metric</label><input
        id="lab-metric"
        value="http_requests_total"
        list="lab-metrics"
        required
        maxlength="256"
      /><datalist id="lab-metrics"></datalist>
      <div class="lab-section-heading">
        <h3>Label filters</h3><button
          type="button"
          id="add-filter"
          class="text-button">+ Add filter</button
        >
      </div>
      <div id="filter-rows"></div>
      <datalist id="lab-labels"></datalist><datalist id="lab-values"></datalist>
      <div class="lab-pair">
        <div>
          <label for="lab-rollup">Over time</label><select id="lab-rollup"
            ><option value="none">Latest sample</option><option
              value="rate"
              selected>Counter rate / second</option
            ><option value="increase">Counter increase</option><option
              value="avg_over_time">Average</option
            ><option value="min_over_time">Minimum</option><option
              value="max_over_time">Maximum</option
            ><option value="sum_over_time">Sum of samples</option></select
          >
        </div>
        <div>
          <label for="lab-window">Window (seconds)</label><input
            id="lab-window"
            type="number"
            min="1"
            max="3600"
            step="1"
            value="300"
            required
          />
        </div>
      </div>
      <label for="lab-aggregate">Across series</label><select id="lab-aggregate"
        ><option value="none">Keep individual series</option><option
          value="sum"
          selected>Sum</option
        ><option value="avg">Average</option><option value="min">Minimum</option
        ><option value="max">Maximum</option><option value="count"
          >Count series</option
        ></select
      >
      <div class="lab-pair">
        <div>
          <label for="lab-grouping">Grouping</label><select id="lab-grouping"
            ><option value="none">All series together</option><option
              value="by"
              selected>By labels</option
            ><option value="without">Without labels</option></select
          >
        </div><div>
          <label for="lab-group-labels">Labels (comma separated)</label><input
            id="lab-group-labels"
            value="service"
            placeholder="service, environment"
            maxlength="256"
            list="lab-labels"
          />
        </div>
      </div>
      <div class="lab-pair">
        <div>
          <label for="lab-comparison">Value filter</label><select
            id="lab-comparison"
            ><option value="none">No threshold</option><option value=">"
              >Greater than</option
            ><option value=">=">At least</option><option value="<"
              >Less than</option
            ><option value="<=">At most</option><option value="=="
              >Equal to</option
            ><option value="!=">Not equal to</option></select
          >
        </div><div>
          <label for="lab-threshold">Threshold</label><input
            id="lab-threshold"
            type="number"
            step="any"
            value="1"
            required
          />
        </div>
      </div>
      <p id="lab-error" class="lab-error" role="alert"></p>
      <button id="run-query" class="lab-primary" type="submit" disabled
        >Loading Rust builder…</button
      >
      <p class="lab-hint">
        Filters and grouping compose immutable expressions. Your samples stay in
        this browser.
      </p>
    </form>
    <section class="lab-panel lab-code-panel" aria-label="Generated code">
      <div class="lab-panel-heading">
        <span class="lab-number">02</span><h2>
          See the calls and the query
        </h2><span class="lab-live">Live</span>
      </div>
      <div class="lab-code-heading">
        <h3>MetriCraft · Python</h3><button
          type="button"
          class="text-button"
          data-copy-lab="python-output">Copy Python</button
        >
      </div>
      <pre
        class="lab-code"
        data-no-copy
        id="python-output"
        set:text="Loading…"
      />
      <div class="lab-code-heading">
        <h3>Generated · PromQL</h3><button
          type="button"
          class="text-button"
          data-copy-lab="promql-output">Copy PromQL</button
        >
      </div>
      <pre
        class="lab-code lab-query"
        data-no-copy
        id="promql-output"
        set:text="Loading…"
      />
      <p class="lab-hint">
        The browser uses the same Rust core as Python. In your application,
        persist <code>query</code> anywhere, then pass it to <code
          >client.query()</code
        > or <code>client.query_range()</code>.
      </p>
    </section>
  </div>
  <section class="lab-panel lab-results">
    <div class="lab-panel-heading">
      <span class="lab-number">03</span><h2>Explore the result</h2><span
        id="result-status"
        role="status">Run a query to evaluate your samples.</span
      >
    </div>
    <div class="lab-evaluation">
      <label for="lab-time">Evaluate at (seconds)</label><input
        id="lab-time"
        type="number"
        min="0"
        max="3600"
        step="1"
        value="600"
      /><span>Chart: 0 → evaluation time, 30-second steps</span>
    </div>
    <div id="result-chart" aria-label="Query result chart"></div>
    <div class="lab-table-scroll">
      <table class="lab-result-table">
        <caption>Instant-vector result at the selected time</caption><thead
          ><tr><th scope="col">Labels</th><th scope="col">Value</th></tr></thead
        ><tbody id="result-rows"></tbody>
      </table>
    </div>
    <p id="result-empty" hidden>
      No matching samples. Try removing a label filter or threshold, or choose a
      metric from the dataset.
    </p>
  </section>
  <section class="lab-panel lab-dataset">
    <div class="lab-panel-heading">
      <h2>Your sample data</h2><div class="lab-presets">
        <button type="button" data-fixture="counter">Counter + reset</button
        ><button type="button" data-fixture="gauge">Queue depth</button><button
          type="button"
          id="add-series">+ Add series</button
        >
      </div>
    </div>
    <p>
      Edit labels and values, add your own metrics, or start from a preset.
      Samples are <code>[seconds, value]</code> relative to time zero. Up to 64 series,
      241 samples per series, and 0–3600 seconds. Empty label values count as absent.
    </p>
    <label for="sample-data">Editable sample dataset · JSON</label><textarea
      id="sample-data"
      spellcheck="false"
      rows="14"></textarea>
    <p id="dataset-status" role="status"></p>
  </section>
  <details class="lab-scope">
    <summary>What this simulation evaluates</summary><p>
      This page evaluates the structured selections above, not arbitrary PromQL
      text. It supports exact label matchers, finite float samples, a 5-minute
      instant lookback with an excluded left boundary (Prometheus 3.15),
      left-open/right-closed ranges, the listed rollups, counter reset handling
      and rate extrapolation, aggregations, grouping, and filtering comparisons.
      Rate/increase model Prometheus behavior. Histograms, stale markers, regex
      matching, vector joins, MetricsQL-specific evaluation and server storage
      behavior are outside this simulator. Use a real backend to validate
      production results. Sample values are limited to ±1e12 and timestamps to
      millisecond precision to bound this demo.
    </p><p>
      The Python snippet can run with an installed MetriCraft native build. The
      simulator belongs to these docs; it is not a new SDK query engine.
    </p>
  </details>
  <noscript
    >This interactive example requires JavaScript and WebAssembly. The guides
    and API reference remain readable without JavaScript.</noscript
  >
</div>
<script>
  import "../playground/ui";
</script>
