---
import Shell from "../layouts/Shell.astro";
import { href } from "../data/navigation.mjs";
---

<Shell
  title="Page not found"
  description="Find your way back to the MetriCraft documentation."
  noindex
>
  <main id="content" class="not-found">
    <span class="eyebrow">404 / An empty result</span><h1>
      This path has<br />no matching page.
    </h1><p>
      The page may have moved. Search the documentation or start with the guide.
    </p><div class="hero-ctas">
      <a class="button primary" href={href("getting-started")}
        >Open the guide →</a
      ><button class="button secondary" data-search-open>Search docs</button>
    </div>
  </main>
</Shell>
