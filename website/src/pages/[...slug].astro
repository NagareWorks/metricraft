---
import Home from "../components/Home.astro";
import Doc from "../components/Doc.astro";
import NotFound from "../components/NotFound.astro";
import { pages, localizedPage } from "../data/navigation.mjs";
import { locales } from "../data/locales.mjs";
import type { Locale } from "../data/translate";
export function getStaticPaths() {
  const documents = locales.flatMap((locale) =>
    pages.map((page, index) => ({
      params: { slug: `${locale}/${page.slug}` },
      props: {
        page: localizedPage(page, locale),
        index,
        locale,
        legacy: false,
      },
    })),
  );
  const aliases = pages.map((page, index) => ({
    params: { slug: page.slug },
    props: { page, index, locale: "en", legacy: true },
  }));
  const homes = locales.map((locale) => ({
    params: { slug: locale },
    props: { page: undefined, index: -1, locale, legacy: false },
  }));
  const missing = locales.map((locale) => ({
    params: { slug: `${locale}/404` },
    props: { page: undefined, index: -2, locale, legacy: false },
  }));
  return [...documents, ...aliases, ...homes, ...missing];
}
const { page, index, legacy } = Astro.props;
const locale = Astro.props.locale as Locale;
---

{
  index === -2 ? (
    <NotFound locale={locale} />
  ) : page ? (
    <Doc page={page} index={index} locale={locale} legacy={legacy} />
  ) : (
    <Home locale={locale} />
  )
}
